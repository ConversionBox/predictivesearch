<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
    xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Conversionbox\Predictivesearch\Logger\Handler">
        <arguments>
            <argument name="filesystem" xsi:type="object">Magento\Framework\Filesystem\Driver\File</argument>
        </arguments>
    </type>
    <type name="Conversionbox\Predictivesearch\Logger\Logger">
        <arguments>
            <argument name="name" xsi:type="string"></argument>
            <argument name="handlers"  xsi:type="array">
                <item name="system" xsi:type="object">Conversionbox\Predictivesearch\Logger\Handler</item>
            </argument>
        </arguments>
    </type>
     <preference for="Conversionbox\Predictivesearch\Api\TypesenseSearchRepositoryInterface" type="Conversionbox\Predictivesearch\Model\TypesenseSearchRepository" />
    <preference for="Conversionbox\Predictivesearch\Api\Data\TypesenseSearchInterface" type="Conversionbox\Predictivesearch\Model\Data\TypesenseSearch" />
    <preference for="Conversionbox\Predictivesearch\Api\Data\TypesenseSearchResultsInterface" type="Magento\Framework\Api\SearchResults" />
    <preference for="Magento\Framework\HTTP\Client\Curl" type="Conversionbox\Predictivesearch\Rewrite\Framework\HTTP\Client\Curl" />
    <preference for="Conversionbox\Predictivesearch\Api\ConfigInterface" type="Conversionbox\Predictivesearch\Model\Config"/>
    <preference for="Conversionbox\Predictivesearch\Api\ConfigSaveInterface" type="Conversionbox\Predictivesearch\Model\ConfigSave"/>
 <preference for="Conversionbox\Predictivesearch\Api\FilterInterface" type="Conversionbox\Predictivesearch\Model\GetFilter"/>
    <preference for="Conversionbox\Predictivesearch\Api\SortInterface" type="Conversionbox\Predictivesearch\Model\GetSort"/>
    <preference for="Conversionbox\Predictivesearch\Api\Data\LandingPageInterface" type="Conversionbox\Predictivesearch\Model\LandingPage"/>
     <preference for="Conversionbox\Predictivesearch\Api\LandingPageInterface" type="Conversionbox\Predictivesearch\Model\Landing"/>
          <preference for="Conversionbox\Predictivesearch\Api\UpdatelandingPageInterface" type="Conversionbox\Predictivesearch\Model\UpdateLanding"/>
           <preference for="Conversionbox\Predictivesearch\Api\CategoryAttributeInterface" type="Conversionbox\Predictivesearch\Model\CategoryAttribute"/>
 <type name="Magento\Framework\View\Element\UiComponent\DataProvider\CollectionFactory">
    <arguments>
<argument name="collections" xsi:type="array">
      <item name="conversionbox_predictivesearch_landingpage_listing_data_source" xsi:type="string">Conversionbox\Predictivesearch\Model\ResourceModel\LandingPage\Grid\Collection</item>
      </argument>
</arguments>
</type>
<type name="Conversionbox\Predictivesearch\Model\ResourceModel\LandingPage\Grid\Collection">
   <arguments>
      <argument name="mainTable" xsi:type="string">conversionbox_landing_page</argument>
      <argument name="eventPrefix" xsi:type="string">conversionbox_landing_page_grid_collection</argument>
     <argument name="eventObject" xsi:type="string">conversionbox_landing_page_grid_collection</argument>
      <argument name="resourceModel" xsi:type="string">Conversionbox\Predictivesearch\Model\ResourceModel\LandingPage</argument>
   </arguments>
  </type>  
</config>
