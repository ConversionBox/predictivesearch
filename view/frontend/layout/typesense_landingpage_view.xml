<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" layout="2columns-left" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <attribute name="class" value="page-products"/>
         <referenceBlock name="head.additional">
          <block class="Conversionbox\Predictivesearch\Block\LandingPage" 
                       name="landing_page" 
                       template="Conversionbox_Predictivesearch::landingpage/header.phtml" />
        </referenceBlock>
        <referenceContainer name="columns.top">
            <container name="landing_page_content_wrapper" htmlTag="div" htmlClass="landing-page-content-wrapper" after="-">
                <block class="Conversionbox\Predictivesearch\Block\LandingPage" 
                       name="landing_page_content" 
                       template="Conversionbox_Predictivesearch::landingpage/content.phtml" />
            </container>
        </referenceContainer>

         <referenceContainer name="content">
            <block class="Conversionbox\Predictivesearch\Block\LandingPage"
                   name="custom.block"
                   template="Conversionbox_Predictivesearch::landingpage/list.phtml"/>
        </referenceContainer>
        <referenceContainer name="sidebar.main">
           <block class="Conversionbox\Predictivesearch\Block\LandingPage" name="conversionbox.leftnav" before="-" template="Conversionbox_Predictivesearch::search/layer/landing.phtml">
            <arguments>
                <argument name="view_model" xsi:type="object">Conversionbox\Predictivesearch\ViewModel\General</argument>
            </arguments>
            </block>
      </referenceContainer>
       <referenceBlock name="catalog.compare.sidebar" remove="true"/>
        <referenceBlock name="catalog.whitelist.sidebar" remove="true"/>
        <referenceContainer name="content">
             <referenceBlock name="sidebar.additional" remove="true"/>
        </referenceContainer>

    </body>
</page>
