<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework/View/Layout/etc/page_configuration.xsd">
     <head>
        <css src="Conversionbox_Predictivesearch::css/typesense.css"/>
    </head>
    <body>
        <referenceBlock name="head.additional">
            <block class="Conversionbox\Predictivesearch\Block\Configuration" name="typesense.configuration" template="Conversionbox_Predictivesearch::configuration/configuration.phtml"/>
        </referenceBlock>
        <referenceBlock name="top.search">
            <action method="setTemplate" ifconfig="typesense_general/credentials/enable_frontend">
                <argument name="setTemplate" xsi:type="string">Conversionbox_Predictivesearch::searchautocomplete.phtml</argument>
            </action>
        </referenceBlock>
        <referenceBlock name="category.products.list">
            <action method="setTemplate" ifconfig="typesense_autocomplete/autocomplete/enable_Category" >
                <argument name="template" xsi:type="string">Conversionbox_Predictivesearch::category/list.phtml</argument>
            </action>
        </referenceBlock>

        <referenceBlock name="catalog.leftnav"  ifconfig="typesense_autocomplete/autocomplete/enable_Category" >
            <action method="setTemplate">
                <argument name="template" xsi:type="string">Conversionbox_Predictivesearch::search/layer/category.phtml</argument>
            </action>
            <arguments>
                <argument name="view_model" xsi:type="object">Conversionbox\Predictivesearch\ViewModel\General</argument>
            </arguments>
        </referenceBlock>
    </body>
</page>
